#  VCFIGHTER — Environment Variables
#  Copy this file: cp .env.example .env
#  Then fill in your values below
# ══════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────
API_ID="38674666"
API_HASH="b4f0fbf8fb560c4bc9e7b9f3698e474c"
BOT_TOKEN="8605110121:AAFqtZsrtH6bMtD8BVRkSKbq5ItT5u5idMg"
